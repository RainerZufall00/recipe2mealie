    "Idee vorschlagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest an Idea"
          }
        }
      }
    },
    "Importiere dein erstes Rezept im Tab „Importieren“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import your first recipe in the “Import” tab."
          }
        }
      }
    },
