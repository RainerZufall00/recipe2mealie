    "Rezepte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipes"
          }
        }
      }
    },
    "Rezepte aus Videos, Webseiten, Fotos und Text mit einem Tipp in dein Mealie holen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring recipes from videos, websites, photos and text into your Mealie with a single tap."
          }
        }
      }
    },
    "Rezepte durchsuchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search recipes"
          }
        }
      }
    },
    "Rezepttext einfügen, z. B. aus einer Nachricht oder Videobeschreibung …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste recipe text, e.g. from a message or video description …"
          }
        }
      }
    },
    "Schließen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "Startbildschirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Screen"
          }
        }
      }
    },
    "Tags übernehmen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import tags"
          }
        }
      }
    },
    "Teilen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share"
          }
        }
      }
    },
    "Teilen aus anderen Apps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing from other apps"
          }
        }
      }
    },
    "Text importieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Text"
          }
        }
      }
    },
    "Tippe in YouTube oder Instagram auf **Teilen** und wähle **Recipe2Mealie**. Falls die App fehlt: ganz rechts auf **Mehr** tippen und sie hinzufügen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In YouTube or Instagram, tap **Share** and choose **Recipe2Mealie**. If the app is missing, tap **More** at the far right and add it."
          }
        }
      }
    },
    "Verbinden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        }
      }
    },
    "Verbindung fehlgeschlagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection Failed"
          }
        }
      }
    },
    "YouTube, Instagram, Web": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube, Instagram, web"
          }
        }
      }
    },
    "Zuletzt importiert": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recently Imported"
          }
        }
      }
    },
    "iOS liefert einen Bericht beim nächsten Start nach einem Absturz, manchmal mit etwas Verzögerung. Die Berichte bleiben auf dem Gerät, bis du sie teilst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS delivers a report on the next launch after a crash, sometimes with a delay. Reports stay on the device until you share them."
          }
        }
      }
    },
    "nicht verfügbar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not available"
          }
        }
      }
    },
    "verfügbar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "available"
          }
        }
      }
    },
    "Öffnet ein vorausgefülltes Formular auf GitHub. Du brauchst dafür ein kostenloses GitHub-Konto, die Meldung ist öffentlich sichtbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a prefilled form on GitHub. You need a free GitHub account; the report is public."
          }
        }
      }
    },
    "Übernimmt Schlagwörter der Quelle und legt fehlende Tags in Mealie an. Die Übersetzung erledigt Mealie AI, nachdem das Rezept erstellt wurde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports the source's keywords and creates missing tags in Mealie. Mealie AI translates the recipe after it is created."
          }
        }
      }
    }
  },
  "version": "1.0"
}
