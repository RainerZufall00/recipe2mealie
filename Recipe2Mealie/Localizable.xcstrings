    },
    "Importierte Rezepte erscheinen hier.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported recipes appear here."
          }
        }
      }
    },
    "KI in Mealie einrichten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Up AI in Mealie"
          }
        }
