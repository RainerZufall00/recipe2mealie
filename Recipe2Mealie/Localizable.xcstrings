    "Kategorien übernehmen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import categories"
          }
        }
      }
    },
    "Keine Abstürze erfasst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No crashes recorded."
          }
        }
      }
    },
    "Keine Verbindung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Connection"
          }
        }
      }
    },
    "Kochbuch scannen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a cookbook"
          }
        }
      }
    },
    "Link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link"
          }
        }
      }
    },
    "Link importieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Link"
          }
        }
      }
    },
    "Link zu einem Video (YouTube, Instagram, TikTok) oder einer Rezeptseite.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link to a video (YouTube, Instagram, TikTok) or a recipe page."
          }
        }
      }
    },
    "Links, Texte und Fotos gehen **nur an deinen Mealie-Server**. Für Videos lädt Mealie den Ton und transkribiert ihn mit dem KI-Dienst, den du in Mealie eingerichtet hast.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, text and photos go **only to your Mealie server**. For videos, Mealie downloads the audio and transcribes it with the AI service you set up in Mealie."
          }
        }
      }
    },
    "Mealie im Browser öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Mealie in Browser"
          }
        }
      }
    },
    "Noch keine Importe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Imports Yet"
          }
        }
      }
