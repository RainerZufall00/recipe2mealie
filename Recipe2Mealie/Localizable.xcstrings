      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating log …"
          }
        }
      }
    },
    "Rezept einfügen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a recipe"
          }
        }
      }
    },
    "Rezept importieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Recipe"
          }
        }
      }
