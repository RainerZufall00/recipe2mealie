    "Bild wird heruntergeladen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading image"
          }
        }
      }
    },
    "Dabei wird die Quelle an deinen Mealie-Server gesendet und dort vom eingerichteten KI-Dienst ausgewertet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sends the source to your Mealie server, where the AI service set up there processes it."
          }
        }
      }
    },
    "Das Tageskontingent der YouTube-API ist aufgebraucht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daily YouTube API quota has been used up."
          }
        }
      }
    },
    "Das Video wurde nicht gefunden oder ist privat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video wasn't found or is private."
          }
        }
      }
    },
    "Das dauert meist nur ein paar Sekunden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This usually takes just a few seconds."
          }
        }
      }
    },
    "Das hat nicht geklappt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't work"
          }
        }
      }
    },
    "Das importierte Rezept wird wieder aus Mealie entfernt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The imported recipe will be removed from Mealie."
          }
        }
      }
    },
    "Das lokale Modell hat die Verarbeitung abgelehnt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model declined to process this."
          }
        }
      }
    },
    "Das lokale Modell konnte nicht antworten. Auf dem Simulator steht Apple Intelligence oft nicht bereit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model didn't respond. Apple Intelligence is often unavailable in the Simulator."
          }
        }
      }
    },
    "Das lokale Modell wird noch geladen. Versuch es gleich noch einmal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model is still downloading. Please try again shortly."
          }
        }
      }
    },
    "Der Inhalt wird an %@ gesendet und dort mit Mealie AI ausgewertet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content is sent to %@ and processed there with Mealie AI."
          }
        }
      }
    },
    "Der Link wird an %@ gesendet. Mealie erstellt daraus das Rezept – bei Videos mit dem dort eingerichteten KI-Dienst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is sent to %@. Mealie creates the recipe from it – for videos using the AI service set up there."
          }
        }
      }
    },
    "Der Mealie-Server hat mit Fehler %lld geantwortet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mealie server responded with error %lld."
          }
        }
      }
    },
    "Der YouTube-API-Schlüssel ist ungültig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The YouTube API key is invalid."
          }
        }
      }
    },
    "Die Auswertung passiert auf deinem iPhone. An %@ geht erst das fertige Rezept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing happens on your iPhone. Only the finished recipe is sent to %@."
