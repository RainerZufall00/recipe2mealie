    "Abbrechen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Abmelden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign Out"
          }
        }
      }
    },
    "Abmelden?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign Out?"
          }
        }
      }
    },
    "Absturz": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crash"
          }
        }
      }
    },
