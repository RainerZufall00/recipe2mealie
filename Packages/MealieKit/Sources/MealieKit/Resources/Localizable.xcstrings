    "Anmeldung fehlgeschlagen. Bitte prüfe Benutzername, Passwort oder API-Token.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed. Please check your username, password or API token."
          }
        }
      }
    },
    "Apple Intelligence ist ausgeschaltet. Du kannst es in den Systemeinstellungen aktivieren.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is turned off. You can turn it on in Settings."
