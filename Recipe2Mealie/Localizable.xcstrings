          }
        }
      }
    },
    "Noch schneller: direkt teilen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even faster: share directly"
          }
        }
      }
    },
    "Ohne Server ausprobieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Without a Server"
          }
        }
      }
    },
