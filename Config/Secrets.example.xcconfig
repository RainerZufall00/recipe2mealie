// Copy to Secrets.xcconfig (ignored by Git) and fill in.

// Your Apple developer team ID (Xcode → Settings → Accounts, or developer.apple.com → Membership).
DEVELOPMENT_TEAM =

// Forks: use your own reverse-DNS prefix, bundle IDs are unique per App Store account.
// APP_BUNDLE_ID_PREFIX = com.example.recipe2mealie

// Optional: YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials).
// Restrict it to the iOS apps $(APP_BUNDLE_ID_PREFIX).app and $(APP_BUNDLE_ID_PREFIX).app.ShareExtension
// and to the YouTube Data API v3 only. Without a key, YouTube links go straight to Mealie.
YOUTUBE_API_KEY =
